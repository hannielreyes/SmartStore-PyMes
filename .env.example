# Copia estos valores como variables de entorno en tu equipo o servidor.
SMARTSTORE_SUPABASE_URL=https://tu-proyecto.supabase.co
SMARTSTORE_SUPABASE_KEY=tu_clave_anon_public
SMARTSTORE_USAR_SUPABASE=true
# JSON remoto con version y enlace de descarga de la APK.
SMARTSTORE_UPDATE_URL=https://tu-servidor.example.com/smartstore-update.json
# Checkout por PayPal Sandbox. Nunca subas credenciales reales al repositorio.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Solo para desarrollo sin PayPal; habilita cobros simulados.
SMARTSTORE_PAGO_SIMULADO=false
